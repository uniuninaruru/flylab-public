# Copy to .env (gitignored) on the machine that needs it. Never commit real values.
#
# neuPrint token: only needed for neuprint-python queries. The MaleCNS v1.0 Feather files
# are public on storage.googleapis.com and need no credentials.
NEUPRINT_APPLICATION_CREDENTIALS=
#
# Extra literals that scripts/redact.py should remove from logs (comma-separated).
FLYLAB_REDACT=
